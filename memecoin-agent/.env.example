# Keys for the agent. On Railway, enter these under the service's Variables instead.
# For docker compose, copy this file to .env and fill it in. Never commit .env.

# From @BotFather in Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Your chat id: message your bot once the agent runs and it replies with it
TELEGRAM_CHAT_ID=
# The LarpCheck key the agent already uses on your PC
LARPCHECK_API_KEY=
# Optional: GMGN discovery and safety checks
GMGN_API_KEY=
